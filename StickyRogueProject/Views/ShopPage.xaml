<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StickyRogueProject.Views.ShopPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
    xmlns:models="clr-namespace:StickyRogueProject.Models"
    x:DataType="vm:ShopViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#05020A">

    <Grid>

        <Image Source="shop_full_ui.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="False" />

        <AbsoluteLayout>

            <Label Text="{Binding PlayerCoins, StringFormat='💰  {0} เหรียญ'}"
                   AbsoluteLayout.LayoutBounds="0.50,0.05,0.56,0.055"
                   AbsoluteLayout.LayoutFlags="All"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#FFD94A"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />

            <Label Text="{Binding MerchantGreeting}"
                   AbsoluteLayout.LayoutBounds="0.50,0.38,0.82,0.075"
                   AbsoluteLayout.LayoutFlags="All"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#4A3142"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   MaxLines="2" />

            <Label Text="✦  สินค้าประจำวัน  ✦"
                   AbsoluteLayout.LayoutBounds="0.50,0.465,0.78,0.045"
                   AbsoluteLayout.LayoutFlags="All"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#F5D16B"
                   CharacterSpacing="1"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />

            <Border AbsoluteLayout.LayoutBounds="0.50,0.345,0.72,0.045"
                    AbsoluteLayout.LayoutFlags="All"
                    BackgroundColor="#CC2A1040"
                    Stroke="#8C5BD0"
                    StrokeThickness="1.2"
                    IsVisible="{Binding IsSoldOut}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Label Text="🔒  ซื้อแล้ว 1 ชิ้น — กลับมาครั้งหน้า!"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#E4C8FF"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#C890F0"
                               AbsoluteLayout.LayoutBounds="0.50,0.62,44,44"
                               AbsoluteLayout.LayoutFlags="PositionProportional" />

            <CollectionView ItemsSource="{Binding ShopItems}"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            AbsoluteLayout.LayoutBounds="0.50,0.78,1,0.315"
                            AbsoluteLayout.LayoutFlags="All"
                            SelectionMode="None"
                            TranslationX="10">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="3"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ArtifactItem">

                        <Grid Padding="3,6"
                              HeightRequest="250"
                              TranslationX="-11">

                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Fill"
                                                 VerticalOptions="Fill">

                                <Image Source="{Binding ImageSource}"
                                       HeightRequest="62"
                                       WidthRequest="62"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center" />

                                <Label Text="{Binding Name}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#F5E9D0"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />

                                <Label Text="{Binding LevelDisplay}"
                                       FontSize="11"
                                       TextColor="#B989FF"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsMaxLevel}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#FFD700" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="{Binding Description}"
                                       FontSize="10"
                                       TextColor="#BDAECF"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />

                                <Label Text="{Binding Price, StringFormat='{0} 🪙'}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#FFD94A"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Center" />

                                <Grid HeightRequest="38"
                                      Margin="2,0,2,0">

                                    <Border BackgroundColor="#553184"
                                            Stroke="#8C5BD0"
                                            StrokeThickness="1"
                                            WidthRequest="100">

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsSoldOut}"
                                                         Value="True">
                                                <Setter Property="Opacity" Value="0.3" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Label Text="{Binding BuyButtonText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#FFF1D0"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>

                                    <Button Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.BuyArtifactCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding IsMaxLevel, Converter={StaticResource InvertedBoolConverter}}"
                                            BackgroundColor="Transparent"
                                            Opacity="0.01" />
                                </Grid>

                            </VerticalStackLayout>
                        </Grid>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border BackgroundColor="Transparent"
                    Padding="14,10"
                    Stroke="Transparent"
                    StrokeThickness="1.2"
                    IsVisible="{Binding IsFeedbackVisible}"
                    AbsoluteLayout.LayoutBounds="0.50,0.875,0.84,0.06"
                    AbsoluteLayout.LayoutFlags="All">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Label Text="{Binding FeedbackMessage}"
                       Padding="11,-25"
                       FontSize="12"
                       TextColor="#E4C8FF"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       MaxLines="2" />
            </Border>

            <Label Text="🎮  PLAY  R O P"
                   AbsoluteLayout.LayoutBounds="0.50,0.93,0.6,0.07"
                   AbsoluteLayout.LayoutFlags="All"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#F5D6FF"
                   CharacterSpacing="4"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />

            <Button Command="{Binding MapsToRopCommand}"
                    BackgroundColor="Transparent"
                    Opacity="0"
                    AbsoluteLayout.LayoutBounds="0.50,0.93,0.86,0.07"
                    AbsoluteLayout.LayoutFlags="All" />

            <Button Text="ออกจากร้าน"
                    Clicked="OnExitClicked"
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    TextColor="#7C668C"
                    FontSize="14"
                    AbsoluteLayout.LayoutBounds="0.50,0.95,0.70,0.045"
                    AbsoluteLayout.LayoutFlags="All"
                    TranslationY="30"/>

        </AbsoluteLayout>
    </Grid>
</ContentPage>