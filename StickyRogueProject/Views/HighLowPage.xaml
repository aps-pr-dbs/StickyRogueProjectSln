<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.HighLowPage"
             Title="High Or Low"
             BackgroundColor="#5C0000" 
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
            <Label Text=" HIGH OR LOW " TextColor="Gold" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="{Binding StreakText}" TextColor="{Binding StreakColor}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="16" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <HorizontalStackLayout x:Name="stackCards" Grid.Row="1" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
        </HorizontalStackLayout>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,0,0,30" IsVisible="{Binding IsGameActive}">
            <Button Text="High" Command="{Binding GuessCommand}" CommandParameter="High" BackgroundColor="DarkGreen" TextColor="White" FontSize="18" FontAttributes="Bold" CornerRadius="10" HeightRequest="60" Grid.Column="0"/>
            <Button Text="Low" Command="{Binding GuessCommand}" CommandParameter="Low" BackgroundColor="DarkBlue" TextColor="White" FontSize="18" FontAttributes="Bold" CornerRadius="10" HeightRequest="60" Grid.Column="1"/>
        </Grid>

        <VerticalStackLayout Grid.Row="3" Spacing="15" IsVisible="{Binding IsGameOver}">
            <Button Text="Restart" Command="{Binding StartNewGameCommand}" BackgroundColor="Goldenrod" TextColor="Black" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>