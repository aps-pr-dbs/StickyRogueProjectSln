<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.BlackjackPage"
             xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
             x:DataType="vm:BlackjackViewModel"
             Title="Blackjack 21"
             BackgroundColor="DarkGreen"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto, *, Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Start">
            <Label x:Name="lblDealerScore" Text="{Binding DealerScoreText}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
            <HorizontalStackLayout x:Name="stackDealerMatchScore" Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                <Ellipse WidthRequest="15" HeightRequest="15" Fill="Gray" Stroke="White" StrokeThickness="1" />
                <Ellipse WidthRequest="15" HeightRequest="15" Fill="Gray" Stroke="White" StrokeThickness="1" />
                <Ellipse WidthRequest="15" HeightRequest="15" Fill="Gray" Stroke="White" StrokeThickness="1" />
            </HorizontalStackLayout>
            <ScrollView Orientation="Horizontal" HorizontalOptions="Center">
                <HorizontalStackLayout x:Name="stackDealerCards" Spacing="-30" />
            </ScrollView>
        </VerticalStackLayout>

        <Label x:Name="lblStatus" Grid.Row="1" Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontFamily="Jersey20" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

        <VerticalStackLayout Grid.Row="2" Spacing="10" VerticalOptions="End">
            <Label x:Name="lblPlayerScore" Text="{Binding PlayerScoreText}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
            <HorizontalStackLayout x:Name="stackPlayerMatchScore" Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                <Ellipse WidthRequest="15" HeightRequest="15" Fill="Gray" Stroke="White" StrokeThickness="1" />
                <Ellipse WidthRequest="15" HeightRequest="15" Fill="Gray" Stroke="White" StrokeThickness="1" />
                <Ellipse WidthRequest="15" HeightRequest="15" Fill="Gray" Stroke="White" StrokeThickness="1" />
            </HorizontalStackLayout>
            <ScrollView Orientation="Horizontal" HorizontalOptions="Center">
                <HorizontalStackLayout x:Name="stackPlayerCards" Spacing="-30" />
            </ScrollView>
        </VerticalStackLayout>

        <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,30,0,0">
            <Button x:Name="btnHit" Text="Hit" Command="{Binding HitCommand}" IsVisible="{Binding IsGameActive}" FontFamily="Jersey20" BackgroundColor="DarkRed" TextColor="White" FontAttributes="Bold" CornerRadius="10" Grid.Column="0"/>
            <Button x:Name="btnStand" Text="Stand" Command="{Binding StandCommand}" IsVisible="{Binding IsGameActive}" FontFamily="Jersey20" BackgroundColor="DarkBlue" TextColor="White" FontAttributes="Bold" CornerRadius="10" Grid.Column="1"/>

            <Button x:Name="btnNewGame" Text="{Binding RestartButtonText}" Command="{Binding StartNewGameCommand}" IsVisible="{Binding IsGameOver}" BackgroundColor="Goldenrod" TextColor="Black" FontAttributes="Bold" CornerRadius="10" Grid.ColumnSpan="2"/>
        </Grid>

    </Grid>
</ContentPage>