<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.PopUp.InGameCharacterStatus"
             BackgroundColor="Transparent"
             Shell.NavBarIsVisible="False">

    <Grid>
        <BoxView Color="#80000000" Opacity="0.75" />

        <Border x:Name="PopupCard"
                BackgroundColor="#F5F5F0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="320">

            <VerticalStackLayout Spacing="0">

                <Border BackgroundColor="#2C2C2C"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="20,16">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontFamily="Schoolbell-Regular"
                                   TextColor="#FFFFFF"/>
                            <Label Text="{Binding CharacterClass}"
                                   FontSize="12"
                                   TextColor="#AAAAAA"
                                   FontAttributes="Italic"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#F5C518"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,6"
                                VerticalOptions="Center">
                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                <Label Text="LV"
                                       FontSize="9"
                                       TextColor="#2C2C2C"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding Level}"
                                       FontSize="18"
                                       FontFamily="Schoolbell-Regular"
                                       TextColor="#2C2C2C"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <VerticalStackLayout Padding="20,16" Spacing="14">

                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="XP" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding XpDisplay}" FontSize="11" TextColor="#888888" HorizontalOptions="End" VerticalOptions="Center"/>
                        </Grid>
                        <ProgressBar x:Name="XpBar" ProgressColor="#F5C518" BackgroundColor="#DDDDDD" HeightRequest="7"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#E0E0E0"/>

                    <Grid ColumnDefinitions="*, 20, *" ColumnSpacing="0" RowSpacing="10" RowDefinitions="Auto, Auto, Auto, Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="❤️ HP" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding HpDisplay}" FontSize="11" TextColor="#888888" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>
                            <ProgressBar x:Name="HpBar" ProgressColor="#9ACD32" BackgroundColor="#DDDDDD" HeightRequest="7"/>
                        </VerticalStackLayout>

                        <BoxView Grid.Row="0" Grid.Column="1" WidthRequest="1" HeightRequest="40" Color="#E0E0E0" HorizontalOptions="Center" VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="4">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="💧 MP" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding MpDisplay}" FontSize="11" TextColor="#888888" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>
                            <ProgressBar x:Name="MpBar" ProgressColor="#5BA4F5" BackgroundColor="#DDDDDD" HeightRequest="7"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E0E0E0"/>

                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto" RowSpacing="8" ColumnSpacing="8">

                        <Border Grid.Column="0" BackgroundColor="#EEEEEE" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="⚔️" FontSize="18" HorizontalOptions="Center"/>
                                <Label Text="{Binding AttackPower}" FontSize="16" FontFamily="Schoolbell-Regular" TextColor="#333333" HorizontalOptions="Center"/>
                                <Label Text="ATK" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#EEEEEE" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="🧠" FontSize="18" HorizontalOptions="Center"/>
                                <Label Text="{Binding Intelligence}" FontSize="16" FontFamily="Schoolbell-Regular" TextColor="#333333" HorizontalOptions="Center"/>
                                <Label Text="INT" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" BackgroundColor="#EEEEEE" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,10">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="🛡️" FontSize="18" HorizontalOptions="Center"/>
                                <Label Text="{Binding Defense}" FontSize="16" FontFamily="Schoolbell-Regular" TextColor="#333333" HorizontalOptions="Center"/>
                                <Label Text="DEF" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E0E0E0"/>

                    <Button Text="CLOSE"
                            Command="{Binding CloseCommand}"
                            BackgroundColor="#2C2C2C"
                            TextColor="#FFFFFF"
                            CornerRadius="20"
                            HeightRequest="46"
                            FontFamily="skeleboom"
                            FontSize="15"/>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>