<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.PopUp.InGameCharacterStatus"
             BackgroundColor="Transparent"
             Shell.NavBarIsVisible="False">

    <Grid>

        <Border x:Name="PopupCard"
                BackgroundColor="#2A2431"
                Stroke="#4A3F54"
                StrokeThickness="3"
                StrokeShape="RoundRectangle 24"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="320">

            <VerticalStackLayout Spacing="0">

                <Border BackgroundColor="#1D1721"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 21,21,0,0"
                        Padding="20,16">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Name}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   FontFamily="Schoolbell-Regular"
                                   TextColor="#F6E7BF"/>
                            <Label Text="{Binding CharacterClass}"
                                   FontSize="13"
                                   TextColor="#A69C95"
                                   FontAttributes="Italic"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#D0B56F"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,6"
                                VerticalOptions="Center">
                            <VerticalStackLayout Spacing="-2" HorizontalOptions="Center">
                                <Label Text="LV"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#1D1721"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding Level}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       FontFamily="Schoolbell-Regular"
                                       TextColor="#1D1721"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <VerticalStackLayout Padding="20,18" Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="✨ XP" FontSize="12" FontAttributes="Bold" TextColor="#D0B56F" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding XpDisplay}" FontSize="11" FontAttributes="Bold" TextColor="#D0B56F" HorizontalOptions="End" VerticalOptions="Center"/>
                        </Grid>
                        <ProgressBar x:Name="XpBar" ProgressColor="#D0B56F" BackgroundColor="#3A3142" HeightRequest="8"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="2" Color="#3A3142"/>

                    <Grid ColumnDefinitions="*, 20, *" ColumnSpacing="0" RowSpacing="10" RowDefinitions="Auto, Auto, Auto, Auto">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="❤️ HP" FontSize="12" FontAttributes="Bold" TextColor="#E35252" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding HpDisplay}" FontSize="11" FontAttributes="Bold" TextColor="#E35252" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>
                            <ProgressBar x:Name="HpBar" ProgressColor="#E35252" BackgroundColor="#3A3142" HeightRequest="8"/>
                        </VerticalStackLayout>

                        <BoxView Grid.Row="0" Grid.Column="1" WidthRequest="2" HeightRequest="35" Color="#3A3142" HorizontalOptions="Center" VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="6">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="💧 MP" FontSize="12" FontAttributes="Bold" TextColor="#5299E3" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding MpDisplay}" FontSize="11" FontAttributes="Bold" TextColor="#5299E3" HorizontalOptions="End" VerticalOptions="Center"/>
                            </Grid>
                            <ProgressBar x:Name="MpBar" ProgressColor="#5299E3" BackgroundColor="#3A3142" HeightRequest="8"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="2" Color="#3A3142"/>

                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto" RowSpacing="8" ColumnSpacing="8">

                        <Border Grid.Column="0" BackgroundColor="#342A3D" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="⚔️" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding AttackPower}" FontSize="18" FontAttributes="Bold" FontFamily="Schoolbell-Regular" TextColor="#E35252" HorizontalOptions="Center"/>
                                <Label Text="ATK" FontSize="10" FontAttributes="Bold" TextColor="#A69C95" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#342A3D" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="🧠" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding Intelligence}" FontSize="18" FontAttributes="Bold" FontFamily="Schoolbell-Regular" TextColor="#5299E3" HorizontalOptions="Center"/>
                                <Label Text="INT" FontSize="10" FontAttributes="Bold" TextColor="#A69C95" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" BackgroundColor="#342A3D" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="🛡️" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding Defense}" FontSize="18" FontAttributes="Bold" FontFamily="Schoolbell-Regular" TextColor="#8F9E8F" HorizontalOptions="Center"/>
                                <Label Text="DEF" FontSize="10" FontAttributes="Bold" TextColor="#A69C95" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="2" Color="#3A3142"/>

                    <Button Text="CLOSE"
                            Command="{Binding CloseCommand}"
                            BackgroundColor="#1D1721"
                            TextColor="#D0B56F"
                            BorderColor="#D0B56F"
                            BorderWidth="2"
                            CornerRadius="20"
                            HeightRequest="48"
                            FontFamily="skeleboom"
                            FontSize="16"/>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>