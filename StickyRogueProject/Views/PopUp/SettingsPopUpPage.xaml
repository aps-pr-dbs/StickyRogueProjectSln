<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="StickyRogueProject.Views.PopUp.SettingsPopUpPage">

    <Border BackgroundColor="#3D2D56" Stroke="#C2B194" StrokeThickness="2" StrokeShape="RoundRectangle 20" Padding="25" WidthRequest="300">
        <VerticalStackLayout Spacing="20">
            <Label Text="⚙️ SETTINGS" FontSize="20" FontAttributes="Bold" TextColor="#E8D5A3" HorizontalOptions="Center" CharacterSpacing="2" />

            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <Label Text="🎵 เสียงเพลง (BGM)" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                <Switch x:Name="BgmSwitch" Grid.Column="1" Toggled="OnBgmToggled" OnColor="#A07ED0" />
            </Grid>

            <VerticalStackLayout Spacing="5" Margin="0,-10,0,10">
                <Label Text="ระดับความดัง" FontSize="11" TextColor="#C0B0E0" HorizontalOptions="Center" />
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" ValueChanged="OnVolumeChanged" MinimumTrackColor="#E8D5A3" MaximumTrackColor="#2A1E3E" ThumbColor="#FFFFFF" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <Label Text="🔊 เสียงเกม (SFX)" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                <Switch x:Name="SfxSwitch" Grid.Column="1" Toggled="OnSfxToggled" OnColor="#A07ED0" />
            </Grid>

            <BoxView HeightRequest="1" Color="#5A3E7A" Margin="0,5" />

            <Button Text="ตกลง" Clicked="OnCloseClicked" BackgroundColor="#E8D5A3" TextColor="#3D2D56" FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="45" />
        </VerticalStackLayout>
    </Border>

</toolkit:Popup>