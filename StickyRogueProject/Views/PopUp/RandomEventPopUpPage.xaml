<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           x:Class="StickyRogueProject.Views.PopUp.RandomEventPopUpPage"
           CanBeDismissedByTappingOutsideOfPopup="False"
           Opened="OnPopupOpened">

    <Border x:Name="CardContainer"
            BackgroundColor="#F5F5F5" 
            Stroke="#333333" StrokeThickness="2" 
            WidthRequest="300" StrokeShape="RoundRectangle 15"
            HorizontalOptions="Center" VerticalOptions="Center" Scale="0">

        <VerticalStackLayout Spacing="15" Padding="20" HorizontalOptions="Center">
            <Image Source="{Binding ImagePath}" HeightRequest="180" Aspect="AspectFit"/>
            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Story}" FontSize="14" TextColor="#555555" HorizontalTextAlignment="Center" />

            <Button Text="ยอมรับชะตากรรม" IsVisible="{Binding IsNormalEvent}" Clicked="OnOkClicked" BackgroundColor="#B34A2A" TextColor="White" Margin="0,10,0,0" />

            <HorizontalStackLayout IsVisible="{Binding IsDrugDealer}" Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
                <Button Text="ลองของ" Clicked="OnAcceptDealerClicked" BackgroundColor="#2A7A4A" TextColor="White"/>
                <Button x:Name="RunAwayBtn" Text="วิ่งหนี!" Clicked="OnRunAwayClicked" BackgroundColor="#B34A2A" TextColor="White"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</mct:Popup>