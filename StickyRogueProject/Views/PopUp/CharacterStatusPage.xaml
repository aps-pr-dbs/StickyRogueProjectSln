<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.PopUp.CharacterStatusPage"
             BackgroundColor="#B3000000">
    <Grid>
        <Border VerticalOptions="Center" 
                HorizontalOptions="Center"
                WidthRequest="320"
                Padding="20"
                BackgroundColor="#2C2C2C"
                Stroke="#FFD700"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">
                <Label Text="{Binding ClassName}" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="#FFD700" 
                       HorizontalOptions="Center" />

                <Label Text="{Binding Level, StringFormat='Level {0}'}" 
                       FontSize="16" 
                       TextColor="LightGray" 
                       HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="HP Status" TextColor="White" />
                        <Label Grid.Column="1" Text="{Binding CurrentHp, StringFormat='{0} HP'}" TextColor="#9ACD32" FontAttributes="Bold" />
                    </Grid>
                    <ProgressBar x:Name="barHp" ProgressColor="#9ACD32" HeightRequest="10" />

                    <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                        <Label Grid.Column="0" Text="MP Status" TextColor="White" />
                        <Label Grid.Column="1" Text="{Binding CurrentMp, StringFormat='{0} MP'}" TextColor="#1E90FF" FontAttributes="Bold" />
                    </Grid>
                    <ProgressBar x:Name="barMp" ProgressColor="#1E90FF" HeightRequest="10" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" Margin="0,10">
                    <Label Grid.Column="0" Text="{Binding Atk, StringFormat='ATK: {0}'}" TextColor="#FF4500" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="{Binding Int, StringFormat='MATK: {0}'}" TextColor="#BA55D3" FontAttributes="Bold" HorizontalOptions="End"/>
                </Grid>

                <Button Text="CLOSE"
                        Clicked="OnCloseClicked"
                        BackgroundColor="#E63946"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>