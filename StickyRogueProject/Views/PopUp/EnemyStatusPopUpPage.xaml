<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StickyRogueProject.Views.PopUp.EnemyStatusPopUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StickyRogueProject.Models"
    x:DataType="models:Enemy"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#B3000000">
    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
        <Border BackgroundColor="#2A2431" 
                Stroke="#4A3F54" 
                StrokeThickness="3" 
                StrokeShape="RoundRectangle 24"
                WidthRequest="320"
                Padding="20,24">

            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding Name}" 
                           FontSize="26" 
                           FontAttributes="Bold"
                           FontFamily="Schoolbell-Regular"
                           TextColor="#F6E7BF" 
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding Level, StringFormat='Rank: Loop Level {0}'}" 
                           FontSize="14" 
                           TextColor="#A69C95" 
                           FontAttributes="Italic"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="2" Color="#3A3142" Margin="0,5"/>

                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="12">

                    <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="6">
                        <Label Text="{Binding HpText, StringFormat='❤️ HP: {0}'}" TextColor="#E35252" FontSize="14" FontAttributes="Bold"/>
                        <ProgressBar Progress="{Binding HpProgress}" ProgressColor="#E35252" BackgroundColor="#3A3142" HeightRequest="8"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                        <Label Text="⚔️ ATK" FontSize="12" FontAttributes="Bold" TextColor="#A69C95"/>
                        <Label Text="{Binding Atk}" FontSize="22" FontFamily="Schoolbell-Regular" FontAttributes="Bold" TextColor="#E35252"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="🛡️ DEF" FontSize="12" FontAttributes="Bold" TextColor="#A69C95"/>
                        <Label Text="{Binding Def}" FontSize="22" FontFamily="Schoolbell-Regular" FontAttributes="Bold" TextColor="#8F9E8F"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                        <Label Text="🧠 INT" FontSize="12" FontAttributes="Bold" TextColor="#A69C95"/>
                        <Label Text="{Binding Int}" FontSize="22" FontFamily="Schoolbell-Regular" FontAttributes="Bold" TextColor="#5299E3"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                        <Label Text="🔰 RESIST" FontSize="12" FontAttributes="Bold" TextColor="#A69C95"/>
                        <Label Text="{Binding ResistanceType}" FontSize="16" FontFamily="Schoolbell-Regular" FontAttributes="Bold" TextColor="#D0B56F"/>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="2" Color="#3A3142" Margin="0,5"/>

                <Border BackgroundColor="#1D1721" Padding="12" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="{Binding IntentIcon}" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Next Action:" FontSize="11" TextColor="#A69C95"/>
                            <Label Text="{Binding NextIntent}" FontSize="16" FontFamily="Schoolbell-Regular" FontAttributes="Bold" TextColor="#F6E7BF"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Button Text="CLOSE INTEL" 
                        Clicked="OnCloseClicked"
                        BackgroundColor="#1D1721" 
                        TextColor="#D0B56F" 
                        BorderColor="#D0B56F"
                        BorderWidth="2"
                        FontFamily="skeleboom"
                        FontSize="16"
                        CornerRadius="20"
                        HeightRequest="48"
                        Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>