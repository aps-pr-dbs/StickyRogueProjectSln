<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StickyRogueProject.Views.PopUp.EnemyStatusPopUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StickyRogueProject.Models"
    x:DataType="models:Enemy"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#80000000">
    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
        <Border BackgroundColor="#2D2640" 
                Stroke="#C2B194" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 24"
                WidthRequest="320"
                Padding="20">

            <VerticalStackLayout Spacing="15">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding Name}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#E8D5A3" 
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding Level, StringFormat='Rank: Loop Level {0}'}" 
                           FontSize="14" 
                           TextColor="#9583D5" 
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#4A3F6B" Margin="0,5"/>

                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="12">

                    <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
                        <Label Text="{Binding HpText, StringFormat='HP: {0}'}" TextColor="#FFFFFF" FontSize="16" FontAttributes="Bold"/>
                        <ProgressBar Progress="{Binding HpProgress}" ProgressColor="#B5BC9A" BackgroundColor="#1A1525" HeightRequest="8"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                        <Label Text="⚔️ ATK" FontSize="12" TextColor="#C2B194"/>
                        <Label Text="{Binding Atk}" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="🛡️ DEF" FontSize="12" TextColor="#C2B194"/>
                        <Label Text="{Binding Def}" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                        <Label Text="✨ INT" FontSize="12" TextColor="#C2B194"/>
                        <Label Text="{Binding Int}" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                        <Label Text="🔰 RESIST" FontSize="12" TextColor="#C2B194"/>
                        <Label Text="{Binding ResistanceType}" FontSize="15" FontAttributes="Bold" TextColor="#9583D5"/>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="#4A3F6B" Margin="0,5"/>

                <Border BackgroundColor="#1A1525" Padding="10" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="{Binding IntentIcon}" FontSize="20" VerticalOptions="Center"/>
                        <VerticalStackLayout>
                            <Label Text="Next Action:" FontSize="10" TextColor="#C2B194"/>
                            <Label Text="{Binding NextIntent}" FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Button Text="CLOSE INTEL" 
                        Clicked="OnCloseClicked"
                        BackgroundColor="#574E79" 
                        TextColor="#E8D5A3" 
                        FontAttributes="Bold"
                        CornerRadius="12"
                        Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>