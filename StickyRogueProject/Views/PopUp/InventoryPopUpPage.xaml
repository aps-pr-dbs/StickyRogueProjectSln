<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
               x:Class="StickyRogueProject.Views.PopUp.InventoryPopUpPage"
               x:DataType="vm:InventoryPopUpViewModel">

    <toolkit:Popup.Content>
        <Grid BackgroundColor="#B3000000" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Grid WidthRequest="355" HeightRequest="600" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid WidthRequest="455" HeightRequest="750" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="ui_inventory_popup_panel.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                </Grid>

                <Grid Padding="22,22,22,20" RowDefinitions="78,170,184,52,28,54" RowSpacing="8">
                    <Grid Grid.Row="0">
                        <Grid WidthRequest="460" HeightRequest="90" HorizontalOptions="Center" VerticalOptions="Center" TranslationX="-5" TranslationY="-30">
                            <Image Source="ui_inventory_header_bar.png" Aspect="Fill" InputTransparent="True" />
                        </Grid>
                        <Grid Padding="40,-50,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                <Label Text="Inventory" FontSize="26" FontFamily="skeleboom" FontAttributes="Bold" TextColor="#F6E7BF" CharacterSpacing="1" />
                                <Label Text="{Binding SlotCountText}" FontSize="13" FontAttributes="Bold" TextColor="#BBAE9A" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="42" HeightRequest="42" VerticalOptions="Center" HorizontalOptions="End">
                                <Grid WidthRequest="42" HeightRequest="42" TranslationX="-10">
                                    <Image Source="ui_inventory_badge_green.png" Aspect="Fill" InputTransparent="True" />
                                </Grid>
                                <Label Text="{Binding SlotBadgeText}" FontSize="19" FontFamily="skeleboom" FontAttributes="Bold" TextColor="#1B1B16" HorizontalOptions="Center" VerticalOptions="Center" TranslationX="-10" TranslationY="-3" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid WidthRequest="400" HeightRequest="300" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="ui_inventory_section_panel.png" Aspect="Fill" InputTransparent="True" />
                        </Grid>
                        <VerticalStackLayout Padding="16,16,16,10" Spacing="10">
                            <Label Text="Equipped Artifacts (Max 6)" FontSize="14" FontFamily="skeleboom" FontAttributes="Bold" TextColor="#362336" CharacterSpacing="1" TranslationY="-50" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding ArtifactSlots}" Wrap="Wrap" JustifyContent="SpaceBetween">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InventorySlotUI">
                                        <Grid HeightRequest="64" WidthRequest="86" Margin="0,2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryPopUpViewModel}}, Path=ArtifactSlotTappedCommand}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Grid WidthRequest="84" HeightRequest="72" TranslationY="-20">
                                                <Image Source="ui_inventory_slot.png" Aspect="Fill" InputTransparent="True" />
                                            </Grid>
                                            <Border Margin="7" BackgroundColor="{Binding BackgroundColor}" Stroke="{Binding BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 7" Opacity="0" />
                                            <VerticalStackLayout Spacing="0" Padding="6,5" HorizontalOptions="Center" VerticalOptions="Center" TranslationY="-23">

                                                <Image Source="{Binding Icon}" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />

                                                <Label Text="{Binding Name}" FontSize="7" TextColor="#3E332B" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="2" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid WidthRequest="400" HeightRequest="300" HorizontalOptions="Center" VerticalOptions="Center" TranslationY="40">
                            <Image Source="ui_inventory_section_panel.png" Aspect="Fill" InputTransparent="True" />
                        </Grid>
                        <VerticalStackLayout Padding="16,16,16,10" Spacing="10">
                            <Label Text="Bag Inventory (Max 6)" FontSize="14" FontFamily="skeleboom" FontAttributes="Bold" TextColor="#362336" CharacterSpacing="1" TranslationY="-2" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding BagSlots}" Wrap="Wrap" JustifyContent="SpaceBetween">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InventorySlotUI">
                                        <Grid HeightRequest="68" WidthRequest="86" Margin="0,3">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryPopUpViewModel}}, Path=BagSlotTappedCommand}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Grid WidthRequest="84" HeightRequest="66" TranslationY="20">
                                                <Image Source="ui_inventory_slot.png" Aspect="Fill" InputTransparent="True" />
                                            </Grid>
                                            <Border Margin="7" BackgroundColor="{Binding BackgroundColor}" Stroke="{Binding BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 7" Opacity="0" TranslationY="20" />
                                            <VerticalStackLayout Spacing="0" Padding="6,5" HorizontalOptions="Center" VerticalOptions="Center" TranslationY="20">

                                                <Image Source="{Binding Icon}" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />

                                                <Label Text="{Binding Name}" FontSize="7" TextColor="#3E332B" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="2" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Grid.Row="4" Text="{Binding HintText}" TextColor="#362336" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TranslationY="-15" />

                    <Grid Grid.Row="5" HeightRequest="54" HorizontalOptions="Fill" VerticalOptions="Center">
                        <Grid WidthRequest="300" HeightRequest="100" HorizontalOptions="Center" VerticalOptions="Center" TranslationY="-20">
                            <Image Source="ui_inventory_button_primary.png" Aspect="Fill" InputTransparent="True" />
                        </Grid>
                        <Label Text="Close" FontSize="18" FontFamily="skeleboom" FontAttributes="Bold" TextColor="#FFF7DE" HorizontalOptions="Center" VerticalOptions="Center" TranslationY="-20" />
                        <Button BackgroundColor="Transparent" Opacity="0" Command="{Binding CloseCommand}" TranslationY="-20" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </toolkit:Popup.Content>
</toolkit:Popup>