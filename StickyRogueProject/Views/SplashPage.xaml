<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="StickyRogueProject.Views.SplashPage"
             Title="SplashPage" 
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3E4C9" Offset="0.1" />
            <GradientStop Color="#A77F60" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
        <skia:SKLottieView Source="loading.json"  
               IsAnimationEnabled="True"
               RepeatCount="1" 
               WidthRequest="400" 
               HeightRequest="400" />

        <Label Text="Loading..." FontFamily="skeleboom" FontSize="48"
           VerticalOptions="Center"
            HorizontalOptions="Center" TextColor="#EBEBEB" />
    </VerticalStackLayout>
</ContentPage>