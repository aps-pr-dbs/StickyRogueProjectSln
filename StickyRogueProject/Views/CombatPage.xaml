<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StickyRogueProject.Views.CombatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
    x:DataType="vm:CombatViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#15111C">

    <Grid>
        <AbsoluteLayout>
            <Image Source="battle_bg_dark_forest.png"
                   Aspect="AspectFill"
                   AbsoluteLayout.LayoutBounds="0,0,1,1"
                   AbsoluteLayout.LayoutFlags="All"
                   InputTransparent="True" />

            <Border AbsoluteLayout.LayoutBounds="0.,0.035,0.58,0.15"
                    AbsoluteLayout.LayoutFlags="All"
                    Padding="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                <Grid WidthRequest="220"
                      HeightRequest="115"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                    <Grid x:Name="EnemyPanelGrid"
                          WidthRequest="365"
                          HeightRequest="220"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <Image Source="ui_enemy_status_panel.png"
                               Aspect="Fill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               InputTransparent="True" />
                    </Grid>

                    <Grid x:Name="EnemyContentGrid"
                          WidthRequest="180"
                          HeightRequest="92"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Padding="17,10"
                          RowDefinitions="Auto,Auto,Auto,*"
                          RowSpacing="0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding EnemyName}"
                                   FontFamily="Schoolbell-Regular"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#20171A"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding EnemyLevel, StringFormat='Lv.{0}'}"
                                   FontFamily="Schoolbell-Regular"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#55304F"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="HP"
                                   FontFamily="Schoolbell-Regular"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#873847"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding EnemyHpText}"
                                   FontFamily="Schoolbell-Regular"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#873847"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />
                        </Grid>

                        <ProgressBar Grid.Row="2"
                                     Progress="{Binding EnemyHpProgress}"
                                     ProgressColor="#B94F62"
                                     BackgroundColor="#251E25"
                                     HeightRequest="6"
                                     VerticalOptions="Center" />

                        <HorizontalStackLayout Grid.Row="3"
                                               Spacing="4"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                            <Label Text="{Binding EnemyIntentIcon}"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding EnemyIntentText}"
                                   FontFamily="Schoolbell-Regular"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#55304F"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Button BackgroundColor="Transparent"
                            Opacity="0.01"
                            Command="{Binding ShowEnemyStatusCommand}"
                            Clicked="OnGeneralButtonClicked" />
                </Grid>
            </Border>

            <Grid AbsoluteLayout.LayoutBounds="0.9,0.035,0.30,0.15"
                  AbsoluteLayout.LayoutFlags="All">
                <Border WidthRequest="120"
                        HeightRequest="120"
                        BackgroundColor="#1D1721"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Image x:Name="EnemyImage"
                           Source="{Binding EnemyImageSource}"
                           Aspect="AspectFill"
                           Margin="8"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Border>

                <Image Source="ui_enemy_frame.png"
                       WidthRequest="300"
                       HeightRequest="220"
                       Aspect="Fill"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       InputTransparent="True" />
            </Grid>

            <Grid AbsoluteLayout.LayoutBounds="0.02,0.22,0.84,0.10"
                  AbsoluteLayout.LayoutFlags="All"
                  IsVisible="{Binding IsEnemyTauntVisible}">
                <Border BackgroundColor="#DD15111C"
                        Stroke="#F5E9D0"
                        StrokeThickness="1.2"
                        StrokeShape="RoundRectangle 32,32,32,32"
                        Padding="12,8"
                        HorizontalOptions="End">
                    <Label Text="{Binding EnemyTauntText}"
                           FontFamily="skeleboom"
                           FontSize="12"
                           TextColor="#FFF7DE"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           MaxLines="2" />
                </Border>
            </Grid>

            <Grid AbsoluteLayout.LayoutBounds="0.08,0.37,1,0.20"
       AbsoluteLayout.LayoutFlags="All">

                <Image Source="ui_battle_log_box.png"
            WidthRequest="700"
            HeightRequest="250"
            InputTransparent="True" />

                <Label Text="{Binding CombatLog}"
            Margin="40,24,40,28" 
            HorizontalOptions="Fill"
            HorizontalTextAlignment="Center"
            FontFamily="Schoolbell-Regular"
            FontSize="14"
            FontAttributes="Bold"
            TextColor="#F5E9D0"
            LineBreakMode="WordWrap"
            MaxLines="4"
            LineHeight="1.15"
            VerticalOptions="Center" />

            </Grid>

            <Grid AbsoluteLayout.LayoutBounds="0.06,0.54,0.7,0.09"
                  AbsoluteLayout.LayoutFlags="All"
                  IsVisible="{Binding IsPlayerTauntVisible}"
                  ZIndex="99">
                <Border BackgroundColor="#DD15111C"
                        Stroke="#F5E9D0"
                        StrokeThickness="1.2"
                        StrokeShape="RoundRectangle 32,32,32,32"
                        Padding="12,8"
                        HorizontalOptions="Start">
                    <Label Text="{Binding PlayerTauntText}"
                           FontFamily="skeleboom"
                           FontSize="12"
                           TextColor="#FFF7DE"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           MaxLines="2" />
                </Border>
            </Grid>
            <Grid AbsoluteLayout.LayoutBounds="0.02,0.035,0.30,1.37"
                   AbsoluteLayout.LayoutFlags="All">
                <Border WidthRequest="120"
                        HeightRequest="120"
                        BackgroundColor="#1D1721"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <Image x:Name="PlayerImage"
                           Source="{Binding CharacterImageSource}"
                           Aspect="AspectFill"
                           Margin="8"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Border>

                <Image Source="ui_enemy_frame.png"
                       WidthRequest="300"
                       HeightRequest="220"
                       Aspect="Fill"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       InputTransparent="True" />
            </Grid>
            <Border AbsoluteLayout.LayoutBounds="1.3,0.73,0.80,0.25"
                    AbsoluteLayout.LayoutFlags="All"
                    Padding="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                <Grid WidthRequest="400"
                      HeightRequest="300"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid x:Name="PanelGrid"
                          WidthRequest="350"
                          HeightRequest="160"
                          HorizontalOptions="Fill"
                          VerticalOptions="Center">
                        <Image Source="ui_player_status_panel.png"
                               Aspect="Fill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               InputTransparent="True" />
                    </Grid>


                    <Grid x:Name="ContentGrid"
                          WidthRequest="200"
                          HeightRequest="90"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Padding="4,6"
                          ColumnDefinitions="30.*,0.58*"
                          ColumnSpacing="14">

                        <Grid Grid.Column="0"
                              RowDefinitions="0.28*,0.24*,0.24*,0.24*"
                              RowSpacing="1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Label Text="{Binding CharacterName}"
                                       FontFamily="Schoolbell-Regular"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#20171A"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding CharacterLevel, StringFormat='Lv.{0}'}"
                                       FontFamily="Schoolbell-Regular"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="#55304F"
                                       VerticalOptions="Center" />
                            </Grid>



                            <Grid Grid.Row="1" ColumnDefinitions="18,*,Auto" ColumnSpacing="2">
                                <Label Text="HP" FontFamily="Schoolbell-Regular" FontSize="8" FontAttributes="Bold" TextColor="#873847" VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" Progress="{Binding CharacterHpProgress}" ProgressColor="#B94F62" BackgroundColor="#251E25" HeightRequest="5" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding CharacterHpText}" FontFamily="Schoolbell-Regular" FontSize="8" FontAttributes="Bold" TextColor="#873847" VerticalOptions="Center" />
                            </Grid>

                            <Grid Grid.Row="2" ColumnDefinitions="18,*,Auto" ColumnSpacing="3">
                                <Label Text="MP" FontFamily="Schoolbell-Regular" FontSize="8" FontAttributes="Bold" TextColor="#376B99" VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" Progress="{Binding CharacterMpProgress}" ProgressColor="#4D9CC9" BackgroundColor="#251E25" HeightRequest="5" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding CharacterMpText}" FontFamily="Schoolbell-Regular" FontSize="8" FontAttributes="Bold" TextColor="#376B99" VerticalOptions="Center" />
                            </Grid>

                            <Grid Grid.Row="3" ColumnDefinitions="18,*,Auto" ColumnSpacing="3">
                                <Label Text="XP" FontFamily="Schoolbell-Regular" FontSize="8" FontAttributes="Bold" TextColor="#6D5732" VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" Progress="{Binding CharacterXpProgress}" ProgressColor="#D0B56F" BackgroundColor="#251E25" HeightRequest="5" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding XpDisplay}" FontFamily="Schoolbell-Regular" FontSize="8" FontAttributes="Bold" TextColor="#6D5732" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <Button BackgroundColor="Transparent"
                            Opacity="0.01"
                            Command="{Binding ShowPlayerStatusCommand}"
                            Clicked="OnGeneralButtonClicked" />
                </Grid>
            </Border>

            <Grid AbsoluteLayout.LayoutBounds="0.1,1,1,0.24"
                  AbsoluteLayout.LayoutFlags="All"
                  HeightRequest="200">
                <Grid x:Name="ActionPanelPngGrid"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      TranslationX="0"
                      TranslationY="0">
                </Grid>

                <Border Padding="16,14"
                        BackgroundColor="#66111018"
                        Stroke="#9B7A52"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16">
                    <Grid RowDefinitions="0.24*,0.38*,0.38*"
                          RowSpacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding WaveLabel}"
                                   FontFamily="Schoolbell-Regular"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#F5E9D0"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />

                            <Grid Grid.Column="1"
                                  WidthRequest="120"
                                  HeightRequest="70"
                                  HorizontalOptions="End"
                                  VerticalOptions="Center">
                                <Image Source="ui_button_primary.png"
                                       Aspect="Fill"
                                       InputTransparent="True" />
                                <Label Text="BAG"
                                       FontFamily="Schoolbell-Regular"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Button BackgroundColor="Transparent"
                                        Opacity="0.01"
                                        Command="{Binding OpenInventoryCommand}"
                                        Clicked="OnGeneralButtonClicked" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Grid Grid.Column="0" WidthRequest="200" HeightRequest="100" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="ui_button_primary.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                                <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="icon_attack_claw.png" WidthRequest="60" HeightRequest="70" Aspect="AspectFit" InputTransparent="True" />
                                    <Label Text="Attack" FontFamily="Schoolbell-Regular" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" TranslationX="-10" />
                                </HorizontalStackLayout>
                                <Button BackgroundColor="Transparent" Opacity="0.01" Command="{Binding AttackCommand}" Clicked="OnGeneralButtonClicked" />
                            </Grid>

                            <Grid Grid.Column="1" WidthRequest="200" HeightRequest="100" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="ui_button_primary.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                                <HorizontalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="icon_defend_shield.png" WidthRequest="60" HeightRequest="70" Aspect="AspectFit" InputTransparent="True" />
                                    <Label Text="Defend" FontFamily="Schoolbell-Regular" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" TranslationX="-10" />
                                </HorizontalStackLayout>
                                <Button BackgroundColor="Transparent" Opacity="0.01" Command="{Binding DefendCommand}" Clicked="OnGeneralButtonClicked" />
                            </Grid>

                            <Grid Grid.Column="2" WidthRequest="200" HeightRequest="100" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="ui_button_primary.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                                <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="HP" FontFamily="Schoolbell-Regular" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                                    <Label Text="{Binding HpPotionCount, StringFormat='x{0}'}" FontFamily="Schoolbell-Regular" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Button BackgroundColor="Transparent" Opacity="0.01" Command="{Binding UseItemCommand}" CommandParameter="HP" Clicked="HPPotionBtnClicked" />
                            </Grid>

                        </Grid>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Grid Grid.Column="1" WidthRequest="200" HeightRequest="100" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="ui_button_primary.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                                <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="icon_run_boot.png" WidthRequest="70" HeightRequest="90" Aspect="AspectFit" InputTransparent="True" />
                                    <Label Text="Run" FontFamily="Schoolbell-Regular" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" TranslationX="-10" />
                                </HorizontalStackLayout>
                                <Button BackgroundColor="Transparent" Opacity="0.01" Command="{Binding RunCommand}" Clicked="OnGeneralButtonClicked" />
                            </Grid>

                            <Grid Grid.Column="0" WidthRequest="200" HeightRequest="100" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="ui_button_primary.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                                <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="icon_magic_spark.png" WidthRequest="60" HeightRequest="70" Aspect="AspectFit" InputTransparent="True" />
                                    <Label Text="Magic" FontFamily="Schoolbell-Regular" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" TranslationX="-10" />
                                </HorizontalStackLayout>
                                <Button BackgroundColor="Transparent" Opacity="0.01" Command="{Binding MagicCommand}" Clicked="OnGeneralButtonClicked" />
                            </Grid>

                            <Grid Grid.Column="2" WidthRequest="200" HeightRequest="100" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="ui_button_primary.png" Aspect="Fill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
                                <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="MP" FontFamily="Schoolbell-Regular" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                                    <Label Text="{Binding MpPotionCount, StringFormat='x{0}'}" FontFamily="Schoolbell-Regular" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Button BackgroundColor="Transparent" Opacity="0.01" Command="{Binding UseItemCommand}" CommandParameter="MP" Clicked="ManaPotionBtnClicked" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </AbsoluteLayout>
    </Grid>
</ContentPage>
