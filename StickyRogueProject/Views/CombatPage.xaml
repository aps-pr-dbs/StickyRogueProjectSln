<?xml version="1.0" encoding="utf-8" ?>

<!--
    Layout ตาม Mockup ของทีม (JRPG Style):
      บนซ้าย  = Enemy Status Card (ชื่อ, Level, HP Bar)
      บนขวา   = Enemy Image
      กลางซ้าย = Player Image (กดเพื่อ Status Popup)
      กลางขวา = Player Status Card (ชื่อ, Level, HP, XP)
      ล่าง    = Action Buttons (Attack, Defend, Magic, Run) + Inventory
    Color Palette: Dark Fantasy (#0D0A1A, #1A0D35, #E8D5A3)
-->

<ContentPage
    x:Class="StickyRogueProject.Views.CombatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
    x:DataType="vm:CombatViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#0D0A1A">

    <!-- Grid หลัก 3 แถว: Enemy Zone / Player Zone / Action Bar -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="14" RowSpacing="12">

        <!-- ===== ROW 0: Wave Label + Enemy Zone ===== -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">

            <!-- Wave Label — WaveLabel Binding -->
            <Label
                Text="{Binding WaveLabel}"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="#A090B8"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                CharacterSpacing="2" />

            <!-- Enemy Zone: Status Card ซ้าย + ภาพขวา -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Enemy Status Card — แตะเพื่อเปิด EnemyStatus Popup -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#1A0D35"
                    StrokeThickness="0.5"
                    Stroke="#3A2060"
                    StrokeShape="RoundRectangle 14"
                    Padding="14,12">
                    <Border.GestureRecognizers>
                        <!-- ShowEnemyStatusCommand Binding -->
                        <TapGestureRecognizer Command="{Binding ShowEnemyStatusCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <!-- ชื่อ + Level — EnemyName, EnemyLevel Binding -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Text="{Binding EnemyName}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#E8D5A3" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding EnemyLevel, StringFormat='Lv.{0}'}"
                                FontSize="13"
                                TextColor="#8A7A9A" />
                        </Grid>
                        <!-- HP Bar — EnemyHpProgress, EnemyHpText Binding -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="HP" FontSize="13" TextColor="#D45050" VerticalOptions="Center" />
                            <ProgressBar
                                Progress="{Binding EnemyHpProgress}"
                                ProgressColor="#9ACD32"
                                BackgroundColor="#2A1D45"
                                WidthRequest="70"
                                HeightRequest="7"
                                VerticalOptions="Center" />
                            <Label
                                Text="{Binding EnemyHpText}"
                                FontSize="12"
                                TextColor="#9A8AAA"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Enemy Image Box -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="#130930"
                    StrokeThickness="0.5"
                    Stroke="#3A2060"
                    StrokeShape="RoundRectangle 14"
                    HeightRequest="130">
                    <!-- EnemyImageSource Binding -->
                    <Image
                        Source="{Binding EnemyImageSource}"
                        Aspect="AspectFit"
                        Margin="10" />
                </Border>

            </Grid>
        </VerticalStackLayout>

        <!-- ===== ROW 1: Combat Log + Player Zone ===== -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="12">

            <!-- Combat Log / Dialog Box — CombatLog Binding -->
            <Border
                Grid.Row="0"
                BackgroundColor="#110D22"
                StrokeThickness="0.5"
                Stroke="#2E204A"
                StrokeShape="RoundRectangle 14"
                Padding="16,12">
                <Label
                    Text="{Binding CombatLog}"
                    FontSize="14"
                    TextColor="#C8B8D8"
                    LineHeight="1.5"
                    VerticalOptions="End" />
            </Border>

            <!-- Player Zone: ภาพซ้าย + Status Card ขวา -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">

                
                <!-- CharacterImageSource Binding -->
                <Image
                    Grid.Column="0"
                    Source="{Binding CharacterImageSource}"
                    WidthRequest="150"
                    HeightRequest="150"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    InputTransparent="True"
                    Margin="0, 0, 0, 0" />
                <!-- กดเพื่อ PlayerStatus Popup -->
                
                <!-- Player Status Card -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="#1A0D35"
                    StrokeThickness="0.5"
                    Stroke="#3A2060"
                    StrokeShape="RoundRectangle 14"
                    Padding="14,12"
                    VerticalOptions="End"
                    Margin="0, 0, 0, 7">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding CharacterName}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#E8D5A3" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding CharacterLevel, StringFormat='Lv.{0}'}"
                                    FontSize="13"
                                    TextColor="#8A7A9A" />
                            </Grid>

                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="HP" FontSize="13" TextColor="#D45050" VerticalOptions="Center" />
                                <ProgressBar
                                    Progress="{Binding CharacterHpProgress}"
                                    ProgressColor="#9ACD32"
                                    BackgroundColor="#2A1D45"
                                    WidthRequest="55"
                                    HeightRequest="7"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding CharacterHpText}"
                                    FontSize="11"
                                    TextColor="#9A8AAA"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="MP" FontSize="13" TextColor="#4A90D9" VerticalOptions="Center" />
                                <ProgressBar
                                    Progress="{Binding CharacterMpProgress}"
                                    ProgressColor="#1E90FF"
                                    BackgroundColor="#2A1D45"
                                    WidthRequest="55"
                                    HeightRequest="7"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding CharacterMpText}"
                                    FontSize="11"
                                    TextColor="#9A8AAA"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label
                                        Grid.Column="0"
                                        Text="XP"
                                        FontSize="11"
                                        TextColor="#6A5A7A"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding XpDisplay}"
                                        FontSize="10"
                                        TextColor="#6A5A7A"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center" />
                                </Grid>
                                <ProgressBar
                                    Progress="{Binding CharacterXpProgress}"
                                    ProgressColor="#F5C518"
                                    BackgroundColor="#2A1D45"
                                    HeightRequest="5" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ===== ROW 2: Action Buttons ===== -->
        <Border
            Grid.Row="2"
            BackgroundColor="#1A1035"
            StrokeThickness="0.5"
            Stroke="#3A2060"
            StrokeShape="RoundRectangle 18"
            Padding="14">

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">

                <!-- 2×2 Grid ปุ่มหลัก -->
                <Grid
                    Grid.Column="0"
                    RowDefinitions="*,*"
                    ColumnDefinitions="*,*"
                    RowSpacing="10"
                    ColumnSpacing="10">

                    <!-- Attack — AttackCommand Binding -->
                    <Button
                        Grid.Row="0" Grid.Column="0"
                        Text="⚔️  Attack"
                        Command="{Binding AttackCommand}"
                        BackgroundColor="#2A1050"
                        TextColor="#E8D5A3"
                        FontSize="14"
                        CornerRadius="20"
                        HeightRequest="48" />

                    <!-- Defend — DefendCommand Binding -->
                    <Button
                        Grid.Row="0" Grid.Column="1"
                        Text="🛡️  Defend"
                        Command="{Binding DefendCommand}"
                        BackgroundColor="#2A1050"
                        TextColor="#E8D5A3"
                        FontSize="14"
                        CornerRadius="20"
                        HeightRequest="48" />

                    <!-- Magic — MagicCommand Binding -->
                    <Button
                        Grid.Row="1" Grid.Column="0"
                        Text="✨  Magic"
                        Command="{Binding MagicCommand}"
                        BackgroundColor="#2A1050"
                        TextColor="#C8B0F0"
                        FontSize="14"
                        CornerRadius="20"
                        HeightRequest="48" />

                    <!-- Run — RunCommand Binding -->
                    <Button
                        Grid.Row="1" Grid.Column="1"
                        Text="🏃  Run"
                        Command="{Binding RunCommand}"
                        BackgroundColor="#2A1050"
                        TextColor="#A09080"
                        FontSize="14"
                        CornerRadius="20"
                        HeightRequest="48" />

                </Grid>

                <!-- Inventory Button (ขวา) — OpenInventoryCommand Binding -->
                <!-- แสดงจำนวน Potion ด้วย -->
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Button
                        Text="🎒 Inventory"
                        Command="{Binding OpenInventoryCommand}"
                        BackgroundColor="#1E0F47"
                        TextColor="#C8B0F0"
                        FontSize="13"
                        CornerRadius="16"
                        VerticalOptions="Fill" />

                    <!-- Shortcut ปุ่ม HP Potion -->
                    <!-- UseItemCommand รับ "HP" เป็น CommandParameter -->
                    <Button
                        Text="{Binding HpPotionCount, StringFormat='💊 ×{0}'}"
                        Command="{Binding UseItemCommand}"
                        CommandParameter="HP"
                        BackgroundColor="#2A1040"
                        TextColor="#D45050"
                        FontSize="12"
                        CornerRadius="14"
                        HeightRequest="34" />

                    <!-- Shortcut ปุ่ม MP Potion -->
                    <Button
                        Text="{Binding MpPotionCount, StringFormat='🧪 ×{0}'}"
                        Command="{Binding UseItemCommand}"
                        CommandParameter="MP"
                        BackgroundColor="#2A1040"
                        TextColor="#4A90D9"
                        FontSize="12"
                        CornerRadius="14"
                        HeightRequest="34" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
