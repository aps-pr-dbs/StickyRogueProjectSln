<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StickyRogueProject.Views.CombatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
    x:DataType="vm:CombatViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#574E79">

    <!-- Grid หลัก 3 แถว: Enemy Zone / Player Zone / Action Bar -->
    <Grid Margin="15" RowDefinitions="Auto, *, Auto" RowSpacing="20">

        <!-- ==========================================
             Row 0: Enemy info + Enemy image (Top)
             ========================================== -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *" ColumnSpacing="15">

            <!-- Enemy Status Card -->
            <Border Grid.Column="0"
                    BackgroundColor="#9583D5"
                    StrokeThickness="0.5"
                    Stroke="#C2B194"
                    StrokeShape="RoundRectangle 14"
                    Padding="14,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowEnemyStatusCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <!-- ชื่อ + Level -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{Binding EnemyName}"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding EnemyLevel, StringFormat='Lv.{0}'}"
                            FontSize="13"
                            TextColor="#574E79" />
                    </Grid>

                    <!-- HP Bar (ปรับเป็นแบบเดียวกับ XP) -->
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label
                                Grid.Column="0"
                                Text="HP"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#C2B194"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding EnemyHpText}"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#FFFFFF"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar
                            Progress="{Binding EnemyHpProgress}"
                            ProgressColor="#B5BC9A"
                            BackgroundColor="#574E79"
                            HeightRequest="5" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Enemy Image Box -->
            <Border
                Grid.Column="1"
                BackgroundColor="#9583D5"
                StrokeThickness="0.5"
                Stroke="#C2B194"
                StrokeShape="RoundRectangle 14"
                HeightRequest="130">
                <Image
                    Source="{Binding EnemyImageSource}"
                    Aspect="AspectFit"
                    Margin="10" />
            </Border>

        </Grid>

        <!-- ==========================================
             Row 1: Combat Log + Player Zone ===== -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="12">

            <!-- Combat Log -->
            <Border
                Grid.Row="0"
                BackgroundColor="#C5A8E1"
                StrokeThickness="0.5"
                Stroke="#C2B194"
                StrokeShape="RoundRectangle 14"
                Padding="16,12">
                <Label
                    Text="{Binding CombatLog}"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#574E79"
                    LineHeight="1.5"
                    VerticalOptions="End" />
            </Border>

            <!-- Player Zone: ภาพซ้าย + Status Card ขวา -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Player Image -->
                <Image
                    Grid.Column="0"
                    Source="{Binding CharacterImageSource}"
                    WidthRequest="150"
                    HeightRequest="150"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    InputTransparent="True"
                    Margin="0, 0, 0, 0" />

                <!-- Player Status Card -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="#9583D5"
                    StrokeThickness="0.5"
                    Stroke="#C2B194"
                    StrokeShape="RoundRectangle 14"
                    Padding="14,12"
                    VerticalOptions="End"
                    Margin="0, 0, 0, 7">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding CharacterName}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#FFFFFF" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding CharacterLevel, StringFormat='Lv.{0}'}"
                                    FontSize="13"
                                    TextColor="#574E79" />
                            </Grid>

                            <!-- HP bar (ปรับเป็นแบบเดียวกับ XP) -->
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label
                                        Grid.Column="0"
                                        Text="HP"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#C2B194"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding CharacterHpText}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#FFFFFF"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center" />
                                </Grid>
                                <ProgressBar
                                    Progress="{Binding CharacterHpProgress}"
                                    ProgressColor="#B5BC9A"
                                    BackgroundColor="#574E79"
                                    HeightRequest="5" />
                            </VerticalStackLayout>

                            <!-- MP bar (ปรับเป็นแบบเดียวกับ XP) -->
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label
                                        Grid.Column="0"
                                        Text="MP"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#C5A8E1"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding CharacterMpText}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#FFFFFF"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center" />
                                </Grid>
                                <ProgressBar
                                    Progress="{Binding CharacterMpProgress}"
                                    ProgressColor="#C5A8E1"
                                    BackgroundColor="#574E79"
                                    HeightRequest="5" />
                            </VerticalStackLayout>

                            <!-- XP bar -->
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label
                                        Grid.Column="0"
                                        Text="XP"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#C2B194"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding XpDisplay}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#FFFFFF"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center" />
                                </Grid>
                                <ProgressBar
                                    Progress="{Binding CharacterXpProgress}"
                                    ProgressColor="#C2B194"
                                    BackgroundColor="#574E79"
                                    HeightRequest="5" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ===== ROW 2: Action Buttons ===== -->
        <Border
            Grid.Row="2"
            BackgroundColor="#C5A8E1"
            StrokeThickness="0.5"
            Stroke="#C2B194"
            StrokeShape="RoundRectangle 18"
            Padding="14">

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">

                <!-- 2×2 Grid ปุ่มหลัก -->
                <Grid
                    Grid.Column="0"
                    RowDefinitions="*,*"
                    ColumnDefinitions="*,*"
                    RowSpacing="10"
                    ColumnSpacing="10">

                    <!-- Attack -->
                    <Button
                        Grid.Row="0" Grid.Column="0"
                        Text="⚔️  Attack"
                        Command="{Binding AttackCommand}"
                        BackgroundColor="#9583D5"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="20"
                        HeightRequest="48" />

                    <!-- Defend -->
                    <Button
                        Grid.Row="0" Grid.Column="1"
                        Text="🛡️  Defend"
                        Command="{Binding DefendCommand}"
                        BackgroundColor="#9583D5"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="20"
                        HeightRequest="48" />

                    <!-- Magic -->
                    <Button
                        Grid.Row="1" Grid.Column="0"
                        Text="✨  Magic"
                        Command="{Binding MagicCommand}"
                        BackgroundColor="#9583D5"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="20"
                        HeightRequest="48" />

                    <!-- Run -->
                    <Button
                        Grid.Row="1" Grid.Column="1"
                        Text="🏃  Run"
                        Command="{Binding RunCommand}"
                        BackgroundColor="#9583D5"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="20"
                        HeightRequest="48" />

                </Grid>

                <!-- Inventory Button & Shortcuts -->
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Button
                        Text="🎒 Inventory"
                        Command="{Binding OpenInventoryCommand}"
                        BackgroundColor="#574E79"
                        TextColor="#C2B194"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="16"
                        VerticalOptions="Fill" />

                    <Button
                        Text="{Binding HpPotionCount, StringFormat='💊 ×{0}'}"
                        Command="{Binding UseItemCommand}"
                        CommandParameter="HP"
                        BackgroundColor="#574E79"
                        TextColor="#B5BC9A"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="14"
                        HeightRequest="34" />

                    <Button
                        Text="{Binding MpPotionCount, StringFormat='🧪 ×{0}'}"
                        Command="{Binding UseItemCommand}"
                        CommandParameter="MP"
                        BackgroundColor="#574E79"
                        TextColor="#C5A8E1"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="14"
                        HeightRequest="34" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>