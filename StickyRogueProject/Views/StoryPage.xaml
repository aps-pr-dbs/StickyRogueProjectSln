<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.StoryPage"
             Title="StoryPage"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="Black">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NextDialogCommand}" />
        </Grid.GestureRecognizers>

        <Image Source="cut1.png"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False">
            <Image.Triggers>
                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="ในโลกที่ความมืดมิดได้กลืนกินแสงสว่างไปจนหมดสิ้น...">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Image.Triggers>
        </Image>

        <Image Source="cut2.png"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False">
            <Image.Triggers>
                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="มอนสเตอร์ออกอาละวาด ผู้คนต่างสูญเสียความหวัง">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Image.Triggers>
        </Image>

        <Image Source="cut3.png"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False">
            <Image.Triggers>
                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="แต่คำทำนายโบราณได้กล่าวถึงผู้กล้าที่จะลุกขึ้นสู้">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Image.Triggers>
        </Image>

        <Image Source="cut4.png"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False">
            <Image.Triggers>
                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="ผู้ที่จะนำพลังแห่งแสงสว่างกลับคืนมายังดินแดนนี้อีกครั้ง">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>

                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="และการเดินทางของคุณ... กำลังจะเริ่มต้นขึ้น ณ บัดนี้">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Image.Triggers>
        </Image>

        <Button Text="Skip"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="16"
                BackgroundColor="Transparent"
                TextColor="#D9D1C6"
                FontSize="16"
                FontFamily="Schoolbell-Regular"
                Command="{Binding SkipCommand}" />
        
        <Label Text="Tap anywhere to continue..."
               VerticalOptions="End"
               HorizontalOptions="Center"
               Margin="0,0,0,10"
               TextColor="#555555"
               FontSize="12" />

    </Grid>
</ContentPage>