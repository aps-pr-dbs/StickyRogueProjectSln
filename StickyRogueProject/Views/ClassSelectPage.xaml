<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StickyRogueProject.Views.ClassSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
    x:DataType="vm:ClassSelectViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#0D0A1A">

    <!-- Grid หลัก: Header / Content (Scrollable) / Select Button -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== ROW 0: Header Bar ===== -->
        <!-- Padding บน 48dp รองรับ Status Bar บน iOS/Android -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="48,*,48"
            Padding="12,48,12,8">

            <Button
                Grid.Column="0"
                Text="←"
                FontSize="18"
                TextColor="#7A6A8A"
                BackgroundColor="Transparent"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                Clicked="OnBackClicked" />

            <!-- หัวข้อ: HorizontalOptions="Fill" + HorizontalTextAlignment="Center" -->
            <Label
                Grid.Column="1"
                Text="Choose Your Class"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="#7A6A8A"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                CharacterSpacing="1" />

            <!-- ตัวนับ Class เช่น "2 / 3" — Binding ยังคงเดิม -->
            <Label
                Grid.Column="2"
                Text="{Binding ClassCounter}"
                FontSize="13"
                TextColor="#50405E"
                HorizontalOptions="End"
                VerticalOptions="Center" />

        </Grid>

        <!-- ===== ROW 1: Scrollable Content ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,20" Spacing="0">

                <!-- ===== Carousel: ลูกศร + Portrait ===== -->
                <!-- ColumnDefinitions: ลูกศรซ้าย 48dp / Portrait ขยาย / ลูกศรขวา 48dp -->
                <Grid ColumnDefinitions="48,*,48" Margin="0,0,0,20">

                    <!-- ลูกศรซ้าย — PreviousClassCommand Binding ยังคงเดิม -->
                    <Button
                        Clicked="selectClassleftBtnClicked"
                        Grid.Column="0"
                        Text="‹"
                        FontSize="32"
                        TextColor="#7B4FBF"
                        BackgroundColor="Transparent"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        VerticalOptions="Center"
                        Command="{Binding PreviousClassCommand}" />

                    <!-- กรอบรูปภาพตัวละคร -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="#180E32"
                        Padding="0"
                        HeightRequest="190"
                        Stroke="{Binding AccentColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Grid>
                            <!-- Source Binding -->
                            <Image
                                Source="{Binding ClassImage}"
                                Aspect="AspectFit"
                                Margin="24"
                                IsVisible="true" />
                        </Grid>

                    </Border>

                    <!-- ลูกศรขวา -->
                    <Button
                        Clicked="selectClassRightBtnClicked"
                        Grid.Column="2"
                        Text="›"
                        FontSize="32"
                        TextColor="#7B4FBF"
                        BackgroundColor="Transparent"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        VerticalOptions="Center"
                        Command="{Binding NextClassCommand}" />

                </Grid>

                <!-- ===== ชื่อ Class + เส้นคั่น + คำอธิบาย ===== -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,20">

                    <!-- ClassName Binding ยังคงเดิม -->
                    <Label
                        Text="{Binding ClassName}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#E8D5A3"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="4" />

                    <!-- เส้นคั่น AccentColor Binding ยังคงเดิม -->
                    <BoxView
                        HeightRequest="2"
                        WidthRequest="64"
                        Color="{Binding AccentColor}"
                        HorizontalOptions="Center" />

                    <!-- ClassDescription Binding ยังคงเดิม -->
                    <Label
                        Text="{Binding ClassDescription}"
                        FontSize="13"
                        TextColor="#70607E"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Center"
                        LineHeight="1.55"
                        Margin="0,4,0,0" />

                </VerticalStackLayout>

                <!-- ===== Stats Panel (ปรับปรุงจาก Frame เป็น Border สำหรับ .NET 10) ===== -->
                <Border
                    BackgroundColor="#110C26"
                    Padding="18,14"
                    Margin="0,0,0,4">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Border.Stroke>
                        <SolidColorBrush Color="#271A45" />
                    </Border.Stroke>

                    <VerticalStackLayout Spacing="12">

                        <!-- หัวข้อ Stats Panel -->
                        <Label
                            Text="BASE STATS"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#50405E"
                            CharacterSpacing="4"
                            HorizontalOptions="Fill"
                            HorizontalTextAlignment="Center" />

                        <!-- ATK Row -->
                        <Grid ColumnDefinitions="26,48,*,40" ColumnSpacing="10" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="⚔️" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="ATK" FontSize="14" TextColor="#B0A0C0" VerticalOptions="Center" />
                            <!-- Progress Binding ยังคงเดิม -->
                            <ProgressBar
                                Grid.Column="2"
                                Progress="{Binding StatAtk, Converter={StaticResource StatToProgressConverter}, ConverterParameter=20}"
                                ProgressColor="#B34A2A"
                                HeightRequest="5"
                                VerticalOptions="Center" />
                            <!-- StatAtk Binding ยังคงเดิม -->
                            <Label
                                Grid.Column="3"
                                Text="{Binding StatAtk}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#E8D5A3"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- DEF Row -->
                        <Grid ColumnDefinitions="26,48,*,40" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="🛡️" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="DEF" FontSize="14" TextColor="#B0A0C0" VerticalOptions="Center" />
                            <ProgressBar
                                Grid.Column="2"
                                Progress="{Binding StatDef, Converter={StaticResource StatToProgressConverter}, ConverterParameter=20}"
                                ProgressColor="#3A4AB0"
                                HeightRequest="5"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="3"
                                Text="{Binding StatDef}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#E8D5A3"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- INT Row -->
                        <Grid ColumnDefinitions="26,48,*,40" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="🔮" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="INT" FontSize="14" TextColor="#B0A0C0" VerticalOptions="Center" />
                            <ProgressBar
                                Grid.Column="2"
                                Progress="{Binding StatInt, Converter={StaticResource StatToProgressConverter}, ConverterParameter=20}"
                                ProgressColor="#7B2FBE"
                                HeightRequest="5"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="3"
                                Text="{Binding StatInt}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#E8D5A3"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- เส้นคั่นก่อน HP -->
                        <BoxView HeightRequest="1" Color="#241840" />

                        <!-- HP Row — สำคัญที่สุด แยกออกมาเพื่อเน้นสายตา -->
                        <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="❤️" FontSize="15" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="HP สูงสุด"
                                FontSize="14"
                                TextColor="#B0A0C0"
                                VerticalOptions="Center" />
                            <!-- StatHp Binding ยังคงเดิม -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding StatHp}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#D45050"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- MP Row -->
                        <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="💧" FontSize="15" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="MP สูงสุด"
                                FontSize="14"
                                TextColor="#B0A0C0"
                                VerticalOptions="Center" />
                            <!-- StatMp Binding ยังคงเดิม -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding StatMp}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#0000FF"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== ROW 2: Select Button (ติดด้านล่าง) ===== -->
        <!-- Padding ล่าง 34dp รองรับ Home Indicator บน iPhone -->
        <Grid
            Grid.Row="2"
            Padding="20,10,20,34"
            BackgroundColor="#0D0A1A">

            <!-- ActivityIndicator แสดงขณะกำลัง Insert ลง SQLite -->
            <!-- IsRunning และ IsVisible Binding ยังคงเดิม -->
            <ActivityIndicator
                IsRunning="{Binding IsSaving}"
                IsVisible="{Binding IsSaving}"
                Color="#A07ED0"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- ปุ่ม SELECT CLASS — ซ่อนระหว่าง Saving (InvertedBoolConverter Binding ยังคงเดิม) -->
            <Button
                Clicked="selectClassBtnClicked"
                Text="SELECT CLASS  ▶"
                Command="{Binding SelectClassCommand}"
                IsVisible="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#4A2D7A"
                TextColor="#E8D5A3"
                FontSize="15"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="10"
                HorizontalOptions="Fill"
                CharacterSpacing="3">
                <Button.Shadow>
                    <Shadow
                        Brush="#7B4FBF"
                        Offset="0,3"
                        Radius="10"
                        Opacity="0.45" />
                </Button.Shadow>
            </Button>

        </Grid>

    </Grid>
</ContentPage>