<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StickyRogueProject.Views.ClassSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
    x:DataType="vm:ClassSelectViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Transparent">

    <Grid>

        <!-- Full screen UI template -->
        <Image Source="characterpick_ui.png"
               Aspect="AspectFill"
               Opacity="1"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True" />


        <!-- Content overlay -->
        <AbsoluteLayout>

            <!-- Back button click layer -->
            <Button BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    TextColor="#E8D5A3"
                    FontSize="340"
                    AbsoluteLayout.LayoutBounds="0.001,0.0225,0.14,0.06"
                    AbsoluteLayout.LayoutFlags="All" />

            <!-- Header title -->
            <Label Text="Choose Your Class"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#E8D5A3"
                   CharacterSpacing="1"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   AbsoluteLayout.LayoutBounds="0.50,0.0225,0.52,0.06"
                   AbsoluteLayout.LayoutFlags="All" />

            <!-- Class counter -->
            <Label Text="{Binding ClassCounter}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#E8D5A3"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   AbsoluteLayout.LayoutBounds="1,0.0225,0.15,0.06"
                   AbsoluteLayout.LayoutFlags="All" />

            <!-- Previous class button -->
            <Button Clicked="selectClassleftBtnClicked"
                    Command="{Binding PreviousClassCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#B56CFF"
                    FontSize="38"
                    AbsoluteLayout.LayoutBounds="0.01,0.27,0.14,0.10"
                    AbsoluteLayout.LayoutFlags="All" />

            <!-- Next class button -->
            <Button Clicked="selectClassRightBtnClicked"
                    Command="{Binding NextClassCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#B56CFF"
                    FontSize="38"
                    AbsoluteLayout.LayoutBounds="1,0.27,0.14,0.10"
                    AbsoluteLayout.LayoutFlags="All" />

            <!-- Character image -->
            <Image Source="{Binding ClassImage}"
                   Aspect="AspectFit"
                   AbsoluteLayout.LayoutBounds="0.50,0.2,0.48,0.26"
                   AbsoluteLayout.LayoutFlags="All"
                   InputTransparent="True" />

            <!-- Class name -->
            <Label Text="{Binding ClassName}"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="#F4D57A"
                   CharacterSpacing="4"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   AbsoluteLayout.LayoutBounds="0.50,0.475,0.78,0.07"
                   AbsoluteLayout.LayoutFlags="All" />

            <!-- Class description -->
            <Label Text="{Binding ClassDescription}"
                   FontSize="14"
                   TextColor="Black"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   LineHeight="1.45"
                   MaxLines="2"
                   AbsoluteLayout.LayoutBounds="0.50,0.5725,0.82,0.075"
                   AbsoluteLayout.LayoutFlags="All" />

            <!-- Stats panel title -->
            <Label Text="BASE STATS"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#E8D5A3"
                   CharacterSpacing="3"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   AbsoluteLayout.LayoutBounds="0.50,0.635,0.50,0.045"
                   AbsoluteLayout.LayoutFlags="All" />

            <!-- ATK row -->
            <Grid ColumnDefinitions="34,52,*,44"
                  ColumnSpacing="10"
                  AbsoluteLayout.LayoutBounds="0.50,0.695,0.76,0.04"
                  AbsoluteLayout.LayoutFlags="All">

                <Label Grid.Column="0"
                       Text="⚔️"
                       FontSize="17"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="1"
                       Text="ATK"
                       FontSize="15"
                       TextColor="#D8C9E5"
                       VerticalTextAlignment="Center" />

                <ProgressBar Grid.Column="2"
                             Progress="{Binding StatAtk, Converter={StaticResource StatToProgressConverter}, ConverterParameter=20}"
                             ProgressColor="#C94F35"
                             BackgroundColor="#160C22"
                             HeightRequest="6"
                             VerticalOptions="Center" />

                <Label Grid.Column="3"
                       Text="{Binding StatAtk}"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#F4D57A"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center" />
            </Grid>

            <!-- DEF row -->
            <Grid ColumnDefinitions="34,52,*,44"
                  ColumnSpacing="10"
                  AbsoluteLayout.LayoutBounds="0.50,0.735,0.76,0.04"
                  AbsoluteLayout.LayoutFlags="All">

                <Label Grid.Column="0"
                       Text="🛡️"
                       FontSize="17"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="1"
                       Text="DEF"
                       FontSize="15"
                       TextColor="#D8C9E5"
                       VerticalTextAlignment="Center" />

                <ProgressBar Grid.Column="2"
                             Progress="{Binding StatDef, Converter={StaticResource StatToProgressConverter}, ConverterParameter=20}"
                             ProgressColor="#5163D8"
                             BackgroundColor="#160C22"
                             HeightRequest="6"
                             VerticalOptions="Center" />

                <Label Grid.Column="3"
                       Text="{Binding StatDef}"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#F4D57A"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center" />
            </Grid>

            <!-- INT row -->
            <Grid ColumnDefinitions="34,52,*,44"
                  ColumnSpacing="10"
                  AbsoluteLayout.LayoutBounds="0.50,0.775,0.76,0.04"
                  AbsoluteLayout.LayoutFlags="All">

                <Label Grid.Column="0"
                       Text="🔮"
                       FontSize="17"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="1"
                       Text="INT"
                       FontSize="15"
                       TextColor="#D8C9E5"
                       VerticalTextAlignment="Center" />

                <ProgressBar Grid.Column="2"
                             Progress="{Binding StatInt, Converter={StaticResource StatToProgressConverter}, ConverterParameter=20}"
                             ProgressColor="#9B3EE8"
                             BackgroundColor="#160C22"
                             HeightRequest="6"
                             VerticalOptions="Center" />

                <Label Grid.Column="3"
                       Text="{Binding StatInt}"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#F4D57A"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center" />
            </Grid>

            <!-- HP row -->
            <Grid ColumnDefinitions="34,*,Auto"
                  ColumnSpacing="10"
                  AbsoluteLayout.LayoutBounds="0.50,0.835,0.76,0.045"
                  AbsoluteLayout.LayoutFlags="All">

                <Label Grid.Column="0"
                       Text="❤️"
                       FontSize="18"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="1"
                       Text="HP สูงสุด"
                       FontSize="16"
                       TextColor="#D8C9E5"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="2"
                       Text="{Binding StatHp}"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="#F05C5C"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center" />
            </Grid>

            <!-- MP row -->
            <Grid ColumnDefinitions="34,*,Auto"
                  ColumnSpacing="10"
                  AbsoluteLayout.LayoutBounds="0.50,0.875,0.76,0.045"
                  AbsoluteLayout.LayoutFlags="All">

                <Label Grid.Column="0"
                       Text="💧"
                       FontSize="18"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="1"
                       Text="MP สูงสุด"
                       FontSize="16"
                       TextColor="#D8C9E5"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="2"
                       Text="{Binding StatMp}"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="#3D6DFF"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center" />
            </Grid>

            <!-- Saving indicator -->
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                               IsVisible="{Binding IsSaving}"
                               Color="#C890F0"
                               AbsoluteLayout.LayoutBounds="0.50,0.952,44,44"
                               AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- Select button text -->
            <Label Text="SELECT CLASS  ▶"
                   IsVisible="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#F4D57A"
                   CharacterSpacing="3"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   AbsoluteLayout.LayoutBounds="0.50,0.98,0.84,0.065"
                   AbsoluteLayout.LayoutFlags="All"
                   TranslationY="2"/>

            <!-- Select button click layer -->
            <Button Clicked="selectClassBtnClicked"
                    Command="{Binding SelectClassCommand}"
                    IsVisible="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="Transparent"
                    Opacity="0.01"
                    AbsoluteLayout.LayoutBounds="0.50,0.98,0.84,0.065"
                    AbsoluteLayout.LayoutFlags="All" />

        </AbsoluteLayout>

    </Grid>
</ContentPage>