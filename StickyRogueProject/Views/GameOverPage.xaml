<!-- Views/GameOverPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.GameOverPage"
             BackgroundColor="#0A0000"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NextDialogCommand}" />
        </Grid.GestureRecognizers>

        <!-- ข้อความ GAME OVER ตรงกลาง -->
        <Label Text="💀 GAME OVER"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               TextColor="#8B0000"
               FontSize="36"
               FontAttributes="Bold"
               Margin="0,0,0,120" />

        <Button Text="Skip >>"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="20"
                BackgroundColor="Transparent"
                TextColor="#888888"
                FontSize="16"
                Command="{Binding SkipCommand}" />

        <Border VerticalOptions="End"
                Margin="20,20,20,40"
                Padding="20"
                BackgroundColor="#1A0000"
                StrokeThickness="2"
                Stroke="#8B0000"
                StrokeShape="RoundRectangle 10">
            <Label Text="{Binding CurrentDialogText}"
                   FontSize="18"
                   TextColor="#DDDDDD"
                   LineBreakMode="WordWrap" />
        </Border>

        <Label Text="Tap anywhere to continue..."
               VerticalOptions="End"
               HorizontalOptions="Center"
               Margin="0,0,0,10"
               TextColor="#555555"
               FontSize="12" />
    </Grid>
</ContentPage>