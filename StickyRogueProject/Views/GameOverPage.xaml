<!-- Views/GameOverPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.GameOverPage"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NextDialogCommand}" />
        </Grid.GestureRecognizers>

        <!-- Game Over full screen image -->
        <Image Source="gameover.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True" />

        <!-- Overlay มืดนิด ๆ ถ้าต้องการให้ dialog อ่านง่ายขึ้น -->
        <!-- ถ้ารู้สึกภาพมืดอยู่แล้ว ลบ BoxView นี้ได้ -->
        <BoxView Color="#000000"
                 Opacity="0.18"
                 InputTransparent="True" />

        <Button Text="Skip >>"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="20"
                BackgroundColor="Transparent"
                TextColor="#DDDDDD"
                FontSize="16"
                Command="{Binding SkipCommand}" />

        <Border VerticalOptions="End"
                Margin="20,20,20,40"
                Padding="20"
                BackgroundColor="#CC1A0000"
                StrokeThickness="2"
                Stroke="#8B0000"
                StrokeShape="RoundRectangle 10">
            <Label Text="{Binding CurrentDialogText}"
                   FontSize="18"
                   TextColor="#DDDDDD"
                   LineBreakMode="WordWrap" />
        </Border>

        <Label Text="Tap anywhere to continue..."
               VerticalOptions="End"
               HorizontalOptions="Center"
               Margin="0,0,0,10"
               TextColor="#BBBBBB"
               FontSize="12" />
    </Grid>
</ContentPage>