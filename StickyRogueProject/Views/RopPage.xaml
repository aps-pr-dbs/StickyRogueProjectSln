<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
             x:Class="StickyRogueProject.Views.RopPage"
             x:DataType="vm:RopViewModel"
             BackgroundColor="#0D0A1A"
             Shell.NavBarIsVisible="False">

    <Grid Margin="20">
        <Border Stroke="#5A3E7A" StrokeThickness="2" HorizontalOptions="Center" WidthRequest="400" 
                VerticalOptions="Center" BackgroundColor="#1A142A" StrokeShape="RoundRectangle 20">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="15" HorizontalOptions="Center">

                    <Label Text="GAMBLE WITH THE DEVIL" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#E8D5A3" />
                    <Label Text="ชนะรับฟรี Artifact / แพ้เสียค่า Stat" FontSize="12" TextColor="#8A7A9A" HorizontalOptions="Center" Margin="0,-10,0,10"/>

                    <Image Source="merchant.png" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center" />

                    <Border BackgroundColor="#2A1D4A" Stroke="#BA55D3" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,5,0,10">
                        <Label Text="{Binding ShopkeeperDialogue}" 
                               TextColor="#E8D5A3" 
                               FontSize="14" 
                               FontAttributes="Italic" 
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <HorizontalStackLayout IsVisible="{Binding IsVsVisible}" Spacing="20" HorizontalOptions="Center" Margin="0,10">
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="YOU" FontAttributes="Bold" TextColor="#C8B8E8" HorizontalOptions="Center"/>
                            <Border BackgroundColor="#2A1D4A" StrokeShape="RoundRectangle 15" WidthRequest="90" HeightRequest="90" Stroke="#5A3E7A">
                                <Image Source="{Binding UserChoiceImage}" Aspect="AspectFit" Margin="15"/>
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="VS" VerticalOptions="Center" FontSize="26" FontAttributes="Bold" TextColor="#E8D5A3" Margin="0,25,0,0"/>

                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="SHOPKEEPER" FontAttributes="Bold" TextColor="#C8B8E8" HorizontalOptions="Center"/>
                            <Border BackgroundColor="#2A1D4A" StrokeShape="RoundRectangle 15" WidthRequest="90" HeightRequest="90" Stroke="#5A3E7A">
                                <Image Source="{Binding CpuChoiceImage}" Aspect="AspectFit" Margin="15"/>
                            </Border>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Label Text="{Binding ResultText}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{Binding ResultColor}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15" HorizontalOptions="Center" Margin="0,10" IsEnabled="{Binding IsActionEnabled}">
                        <ImageButton Grid.Column="0" Source="hammer.png" BackgroundColor="#4A2D7A" Padding="15" CornerRadius="20" WidthRequest="90" HeightRequest="90" Command="{Binding PlayRopCommand}" CommandParameter="Rock"/>
                        <ImageButton Grid.Column="1" Source="scissors.png" BackgroundColor="#4A2D7A" Padding="15" CornerRadius="20" WidthRequest="90" HeightRequest="90" Command="{Binding PlayRopCommand}" CommandParameter="Scissors"/>
                        <ImageButton Grid.Column="2" Source="paper.png" BackgroundColor="#4A2D7A" Padding="15" CornerRadius="20" WidthRequest="90" HeightRequest="90" Command="{Binding PlayRopCommand}" CommandParameter="Paper"/>
                    </Grid>

                    <Button Text="RETURN TO COMBAT" 
                            Command="{Binding ExitGameCommand}" 
                            IsVisible="{Binding IsGameOver}" 
                            BackgroundColor="#D9534F" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="15" 
                            HeightRequest="45" 
                            Margin="0,10,0,0" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>