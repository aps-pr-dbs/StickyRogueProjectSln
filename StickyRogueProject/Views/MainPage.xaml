<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StickyRogueProject.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StickyRogueProject.ViewModels"
    x:DataType="vm:MainPageViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#0D0A1A">

    <Grid RowDefinitions="*,Auto,*">

        <VerticalStackLayout
            Grid.Row="0"
            VerticalOptions="End"
            HorizontalOptions="Fill"
            Spacing="10"
            Padding="32,0,32,36">

            <Label
                Text="STICKY ROGUE"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="#E8D5A3"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                CharacterSpacing="8" />

            <BoxView
                HeightRequest="1"
                WidthRequest="140"
                Color="#5A3E7A"
                HorizontalOptions="Center" />

            <Label
                Text="⚔  Turn-Based RogueLike  ⚔"
                FontSize="13"
                TextColor="#7A6A8A"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                CharacterSpacing="1" />

        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="11"
            Padding="32,0,32,0"
            VerticalOptions="Center">

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#A07ED0"
                HeightRequest="28"
                HorizontalOptions="Center" />

            <Button
                Text="▶ START GAME"
                Command="{Binding NewGameCommand}"
                BackgroundColor="#4A2D7A"
                TextColor="#E8D5A3"
                FontSize="15"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="10"
                HorizontalOptions="Fill"
                CharacterSpacing="3">
                <Button.Shadow>
                    <Shadow Brush="#7B4FBF" Offset="0,3" Radius="8" Opacity="0.5" />
                </Button.Shadow>
            </Button>

            <Button
                Text="↺ LOAD GAME"
                Clicked="OnLoadGameBtnClicked"
                BackgroundColor="#221640"
                TextColor="#C0B0E0"
                FontSize="15"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="10"
                HorizontalOptions="Fill"
                CharacterSpacing="3" />

            <Label
                Text="ยังไม่มีข้อมูล Save  —  กด New Game เพื่อเริ่มเล่น"
                FontSize="12"
                TextColor="#4A3A5A"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasExistingSave, Converter={StaticResource InvertedBoolConverter}}" />

            <BoxView HeightRequest="6" Color="Transparent" />

            <Button
                Text="📜   HISTORY"
                Clicked="OnHistoryBtnClicked"
                BackgroundColor="Transparent"
                TextColor="#645478"
                FontSize="14"
                HeightRequest="44"
                CornerRadius="10"
                HorizontalOptions="Fill"
                CharacterSpacing="2"
                BorderColor="#2A1D48"
                BorderWidth="1" />

        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            Text="v0.1.0  —  Phase 1 Build"
            FontSize="11"
            TextColor="#2A1E3E"
            HorizontalOptions="Fill"
            HorizontalTextAlignment="Center"
            VerticalOptions="End"
            Margin="0,0,0,30" />

    </Grid>
</ContentPage>