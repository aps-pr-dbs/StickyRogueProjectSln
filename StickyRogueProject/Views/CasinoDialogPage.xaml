<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.CasinoDialogPage"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Border BackgroundColor="#110D22" 
                Stroke="#D45050" 
                StrokeThickness="1" 
                StrokeShape="RoundRectangle 10" 
                Padding="20" 
                Margin="20,0,20,40"
                VerticalOptions="End">

            <VerticalStackLayout Spacing="15">
                <Label x:Name="lblMessage" 
                       TextColor="White" 
                       FontSize="16" 
                       LineHeight="1.5" 
                       FontFamily="skeleboom" />

                <Button Text="Tap anywhere to continue..." 
                        Clicked="BtnContinue_Clicked" 
                        BackgroundColor="Transparent" 
                        TextColor="#8A7A9A" 
                        FontSize="12" 
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="BtnContinue_Clicked"/>
        </Grid.GestureRecognizers>
    </Grid>
</ContentPage>