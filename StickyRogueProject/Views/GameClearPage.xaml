<!-- Views/GameClearPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.GameClearPage"
             BackgroundColor="#050A00"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NextDialogCommand}" />
        </Grid.GestureRecognizers>

        <!-- ข้อความ GAME CLEAR ตรงกลาง -->
        <Label Text="🏆 GAME CLEAR"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               TextColor="#FFD700"
               FontSize="36"
               FontAttributes="Bold"
               Margin="0,0,0,120" />

        <!-- แสงประดับพื้นหลัง (subtle glow) -->
        <BoxView Color="#FFD700"
                 Opacity="0.04"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />

        <Button Text="Skip >>"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="20"
                BackgroundColor="Transparent"
                TextColor="#888888"
                FontSize="16"
                Command="{Binding SkipCommand}" />

        <Border VerticalOptions="End"
                Margin="20,20,20,40"
                Padding="20"
                BackgroundColor="#0D1A00"
                StrokeThickness="2"
                Stroke="#FFD700"
                StrokeShape="RoundRectangle 10">
            <Label Text="{Binding CurrentDialogText}"
                   FontSize="18"
                   TextColor="#EEEEEE"
                   LineBreakMode="WordWrap" />
        </Border>

        <Label Text="Tap anywhere to continue..."
               VerticalOptions="End"
               HorizontalOptions="Center"
               Margin="0,0,0,10"
               TextColor="#555555"
               FontSize="12" />
    </Grid>
</ContentPage>
