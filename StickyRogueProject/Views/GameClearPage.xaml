<!-- Views/GameClearPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.GameClearPage"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NextDialogCommand}" />
        </Grid.GestureRecognizers>

        <!-- Default background: แสดงตลอด กันช่วง dynamic text แล้วรูปหาย -->
        <Image Source="end1.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True" />

        <!-- END 2: ทับ end1 เมื่อเจอบทช่วงกลาง -->
        <Image Source="end2.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False">
            <Image.Triggers>
                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="เงาแห่งความมืดมิดที่ปกคลุมดินแดนนี้มานานหลายศตวรรษ...">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>

                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="ได้สลายหายไปพร้อมกับลมหายใจสุดท้ายของราชาปีศาจ">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>

                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="ผู้คนต่างออกมาจากที่หลบซ่อน ร้องเพลงสดุดีนักรบผู้ยิ่งใหญ่">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Image.Triggers>
        </Image>

        <!-- END 3: ทับ end1 เมื่อเจอบทช่วงท้าย -->
        <Image Source="end3.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False">
            <Image.Triggers>
                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="ตำนานบทนี้จะถูกจารึกไว้ตลอดกาล">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>

                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="ขอบคุณที่ร่วมเดินทางมาด้วยกัน...">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>

                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="🏆 THE END 🏆">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>

                <DataTrigger TargetType="Image"
                             Binding="{Binding CurrentDialogText}"
                             Value="บันทึกประวัติ......">
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Image.Triggers>
        </Image>

        <!-- Overlay มืดนิด ๆ เพื่อให้อ่าน dialog ง่าย -->
        <BoxView Color="#000000"
                 Opacity="0.18"
                 InputTransparent="True" />

        <Button Text="Skip >>"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="20"
                BackgroundColor="Transparent"
                TextColor="#DDDDDD"
                FontSize="16"
                Command="{Binding SkipCommand}" />

        <Border VerticalOptions="End"
                Margin="20,20,20,40"
                Padding="20"
                BackgroundColor="#CC0D1A00"
                StrokeThickness="2"
                Stroke="#FFD700"
                StrokeShape="RoundRectangle 10">
            <Label Text="{Binding CurrentDialogText}"
                   FontSize="18"
                   TextColor="#EEEEEE"
                   LineBreakMode="WordWrap" />
        </Border>

        <Label Text="Tap anywhere to continue..."
               VerticalOptions="End"
               HorizontalOptions="Center"
               Margin="0,0,0,10"
               TextColor="#CCCCCC"
               FontSize="12" />
    </Grid>
</ContentPage>