<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StickyRogueProject.Views.CasinoMenu"
             Title="Casino Menu"
             BackgroundColor="#0D0A1A"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="3*, Auto, 3*" Padding="20">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,40">
            <Label Text="🎰 STICK 🎰" 
                   FontFamily="Jersey20" 
                   FontSize="45" 
                   FontAttributes="Bold" 
                   TextColor="#E8D5A3" 
                   HorizontalOptions="Center" />
            <Label Text="CASINO" 
                   FontFamily="Jersey20" 
                   FontSize="45" 
                   FontAttributes="Bold" 
                   TextColor="#D45050" 
                   HorizontalOptions="Center" />
            <Label Text="เข้ามากระเป๋าตุง... หรือเดินนุ่งลมห่มฟ้า?" 
                   FontFamily="skeleboom" 
                   FontSize="16" 
                   TextColor="#8A7A9A" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,0"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="20" HorizontalOptions="Center">
            <Button x:Name="btnBlackjack" 
                    Text="Blackjack 21" 
                    FontFamily="Jersey20" 
                    FontSize="20" 
                    FontAttributes="Bold" 
                    BackgroundColor="#2A1050" 
                    TextColor="#E8D5A3" 
                    WidthRequest="330" 
                    HeightRequest="65" 
                    CornerRadius="15" 
                    Clicked="BtnBlackjack_Clicked">
                <Button.Shadow>
                    <Shadow Brush="#1A0D35" Offset="0,5" Radius="10" Opacity="0.8"/>
                </Button.Shadow>
            </Button>

            <Button x:Name="btnHighLow" 
                    Text="High Or Low" 
                    FontFamily="Jersey20" 
                    FontSize="20" 
                    FontAttributes="Bold" 
                    BackgroundColor="#2A1050" 
                    TextColor="#E8D5A3" 
                    WidthRequest="330" 
                    HeightRequest="65" 
                    CornerRadius="15" 
                    Clicked="BtnHighLow_Clicked">
                <Button.Shadow>
                    <Shadow Brush="#1A0D35" Offset="0,5" Radius="10" Opacity="0.8"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <Button Grid.Row="2" 
                Text="Exit Casino" 
                Clicked="BtnExit_Clicked" 
                BackgroundColor="#1E0F47" 
                TextColor="#C8B0F0" 
                FontFamily="skeleboom" 
                WidthRequest="200" 
                HeightRequest="50" 
                CornerRadius="25" 
                VerticalOptions="Start" 
                Margin="0,40,0,0" />
    </Grid>
</ContentPage>